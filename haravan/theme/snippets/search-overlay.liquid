{% comment %}Ô tìm kiếm nhanh: gõ tới đâu gợi ý tới đó (lấy từ templates/search.suggest.liquid). Mở bằng nút kính lúp hoặc phím "/"{% endcomment %}
<div class="srch" id="srch" hidden>
  <div class="srch-bg" data-srch-close></div>
  <div class="srch-panel" role="dialog" aria-modal="true" aria-label="Tìm kiếm sản phẩm">
    <form action="/search" method="get" class="srch-form" role="search">
      <input type="hidden" name="type" value="product" />
      {% assign icon = 'search' %}{% include 'icon' %}
      <input type="search" name="q" id="srch-q" placeholder="Bạn đang tìm gì? Ví dụ: tăm nước" autocomplete="off" aria-label="Từ khoá" aria-controls="srch-res" aria-autocomplete="list" />
      <button type="button" class="icon-btn" data-srch-close aria-label="Đóng tìm kiếm">{% assign icon = 'close' %}{% include 'icon' %}</button>
    </form>
    <div class="srch-body">
      {% if settings.search_suggest != blank %}
      <div class="srch-tags" data-srch-tags>
        <span class="srch-lab">Tìm nhiều</span>
        {% assign words = settings.search_suggest | split: ',' %}
        {% for w in words %}{% assign w = w | strip %}{% if w != blank %}<a class="pill" href="/search?type=product&q={{ w | escape | replace: ' ', '+' }}" data-srch-word="{{ w | escape }}">{{ w }}</a>{% endif %}{% endfor %}
      </div>
      {% endif %}
      <div class="srch-res" id="srch-res" role="listbox" aria-live="polite"></div>
    </div>
  </div>
</div>
