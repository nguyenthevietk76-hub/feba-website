{% paginate blog.articles by 9 %}
<section class="page-hd"><div class="wrap"><h1 class="h1">{{ blog.title }}</h1></div></section>
<section class="sec tight">
  <div class="wrap posts">
    {% for article in blog.articles %}
    <article class="post rv">
      {% if article.image %}<a class="post-img" href="{{ article.url }}"><img src="{{ article.image.src | img_url: 'large' }}" alt="" loading="lazy" /></a>{% endif %}
      <span class="mute small">{{ article.published_at | date: "%d/%m/%Y" }}</span>
      <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
      <p>{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
      <a class="ulink" href="{{ article.url }}">Đọc tiếp</a>
    </article>
    {% else %}
    <p class="empty">Chưa có bài viết.</p>
    {% endfor %}
  </div>
  <div class="wrap">{% include 'pagination' %}</div>
</section>
{% endpaginate %}
